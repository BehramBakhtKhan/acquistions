    },
    "homepage": "https://github.com/BehramBakhtKhan/acquistions#readme",
    "dependencies": {
        "@arcjet/inspect": "^1.5.0",
        "@arcjet/node": "^1.5.0",
        "@neondatabase/serverless": "^1.1.0",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "express": "^5.2.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.12.1",
        "winston": "^3.19.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "jest": "^30.5.1",
        "prettier": "^3.9.7",
        "supertest": "^7.2.2"
    }
